# Copy to .env and fill in real values before connecting a mailbox or exposing the server.
# docker compose up works without this file: it uses localhost-only development defaults
# and refuses those defaults when NODE_ENV=production.

# Postgres connection string used by the API and the worker.
# Local compose service: postgres://warmysender:warmysender@postgres:5432/warmysender
# On the host, if you publish Postgres: postgres://warmysender:warmysender@localhost:5432/warmysender
DATABASE_URL=

# 32-byte key for AES-256-GCM. Encrypts mailbox passwords, Microsoft refresh tokens,
# and the optional WarmySender API key at rest. Never commit a real key.
# Generate with: openssl rand -base64 32
# A 64-character hex string is also accepted.
ENCRYPTION_KEY=

# Secret used to hash session cookies. At least 32 characters. Not the encryption key.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public base URL of this install, no trailing slash.
# Used for invite links and, later, one-click unsubscribe links (${PUBLIC_URL}/u/:token).
# Docker / production (UI and API on the same origin): http://localhost:3000
# pnpm dev (Vite UI): http://localhost:5173
PUBLIC_URL=

# TCP port the API listens on. The UI is served from this port in Docker. Default: 3000
PORT=3000

# Bind address. Default: 0.0.0.0 so Docker can publish the port.
HOST=0.0.0.0

# development | production | test
# production refuses the development ENCRYPTION_KEY and SESSION_SECRET shipped in docker-compose.yml.
# Default when unset: development
NODE_ENV=development

# Microsoft Entra application for "Sign in with Microsoft" mailboxes.
# Leave both empty until you create an app. The button stays disabled and explains the setup.
# Redirect URL to register on the app: ${PUBLIC_URL}/api/oauth/microsoft/callback
# Scopes: offline_access https://outlook.office.com/SMTP.Send https://outlook.office.com/IMAP.AccessAsUser.All openid email
# Step-by-step doc arrives with the mailbox milestone (docs/MICROSOFT-APP.md).
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Entra tenant: common (any account), organizations, consumers, or a tenant id. Default: common
MS_TENANT=common
